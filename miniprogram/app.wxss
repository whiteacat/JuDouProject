/* 全局样式 */
page {
  background-color: #f7f7f7;
  font-size: 28rpx;
  color: #333;
}

/* 功能图标（SVG base64 内嵌，零依赖） */
.icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
  flex-shrink: 0;
}

.icon-event {
  background-image: url("data:image/svg+xml;base64,");
}

