.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f7f7;
}

.map {
  flex: 1;
  width: 100%;
}

.panel {
  background: #fff;
  padding: 24rpx;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.mode-tab.active {
  color: #fff;
  background: #ff6b35;
}

.info {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.error {
  font-size: 26rpx;
  color: #e64340;
  margin-bottom: 16rpx;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  border-radius: 12rpx;
}

.btn.primary {
  background-color: #ff6b35;
  color: #fff;
}

.btn.secondary {
  background-color: #f5f5f5;
  color: #333;
}
