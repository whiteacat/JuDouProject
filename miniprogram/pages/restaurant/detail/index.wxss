.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
  padding-bottom: 140rpx;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
}

.score-row {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}

.score {
  font-size: 40rpx;
  color: #ff6b35;
  font-weight: bold;
}

.visits {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: 24rpx;
}

.card-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.radar-canvas {
  width: 300px;
  height: 300px;
  margin: 0 auto;
  display: block;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.bar-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
}

.bar-track {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffb37e, #ff6b35);
  border-radius: 8rpx;
}

.bar-score {
  width: 64rpx;
  text-align: right;
  font-size: 26rpx;
  color: #333;
}

.no-review {
  font-size: 26rpx;
  color: #999;
}

.review-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.review-item:last-child {
  border-bottom: none;
}

.review-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.review-nickname {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.review-score {
  font-size: 26rpx;
  color: #ff6b35;
}

.review-content {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.create-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
}
