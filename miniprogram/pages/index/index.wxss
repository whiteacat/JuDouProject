.page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

/* 顶部标题 */
.top-header {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 10;
}

.app-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.app-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 搜索栏 */
.search-bar {
  position: absolute;
  top: 100rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 16rpx;
  z-index: 10;
}

.search-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}

.search-btn {
  margin: 0;
  padding: 0 32rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  height: 72rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.search-btn::after {
  border: none;
}

/* 搜索结果面板：头部固定 + 列表区滚动 */
.results-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 200rpx;
  max-height: 45vh;
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  z-index: 12;
  overflow: hidden;
}

.results-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.results-count {
  font-size: 26rpx;
  color: #999;
}

.results-close {
  padding: 8rpx 16rpx;
  margin-right: -8rpx;
  font-size: 26rpx;
  color: #ff6b35;
}

.results-list {
  flex: 1;
  min-height: 0;
}

.result-item {
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.result-item:last-child {
  border-bottom: none;
}

.result-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.result-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-type {
  display: inline-block;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  font-size: 20rpx;
  border-radius: 8rpx;
  vertical-align: middle;
}

.result-type.event {
  color: #ff6b35;
  background: #fff3ee;
}

.result-type.restaurant {
  color: #4a90d9;
  background: #e8f1fb;
}

.result-dist {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  flex-shrink: 0;
}

.result-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 底部快捷入口（可收起） */
.quick-bar {
  position: absolute;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  right: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 16rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  z-index: 10;
}

.quick-bar.collapsed {
  padding: 0 16rpx;
}

.quick-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #999;
}

.quick-bar:not(.collapsed) .quick-toggle {
  border-bottom: 2rpx solid #f5f5f5;
}

.quick-toggle-text {
  font-weight: 500;
}

.quick-items {
  display: flex;
  justify-content: space-around;
  padding-top: 8rpx;
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.quick-icon-eat {
  background: #fff3ee;
}

.quick-icon-play {
  background: #e8f5e9;
}

.quick-icon-date {
  background: #fce4ec;
}

.quick-icon-team {
  background: #e3f2fd;
}

.quick-label {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

/* 弹层遮罩 */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 20;
}

/* 底部弹层 */
.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 30;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.sheet-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.sheet-meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.sheet-status {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff3ee;
  border-radius: 8rpx;
}

.sheet-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet-btn {
  margin-top: 24rpx;
  background-color: #f5f5f5;
  color: #333;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.sheet-btn.half {
  flex: 1;
  margin-top: 0;
}

.sheet-btn.primary {
  background-color: #ff6b35;
  color: #fff;
}

.sheet-close {
  margin-top: 16rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
}
