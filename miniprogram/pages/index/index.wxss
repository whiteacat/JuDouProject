.page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.top-bar {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 10;
}

.group-select {
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.group-select-value {
  font-size: 28rpx;
  color: #333;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-empty {
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  font-size: 26rpx;
  color: #666;
}

.group-empty-link {
  color: #ff6b35;
  margin-left: 12rpx;
}

.search-bar {
  position: absolute;
  top: 104rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  gap: 16rpx;
  z-index: 10;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-btn {
  margin: 0;
  padding: 0 32rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.results-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 32rpx;
  max-height: 45vh;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
  z-index: 12;
}

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.results-count {
  font-size: 26rpx;
  color: #999;
}

.results-close {
  font-size: 26rpx;
  color: #ff6b35;
}

.result-item {
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.result-item:last-child {
  border-bottom: none;
}

.result-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.result-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-dist {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  flex-shrink: 0;
}

.result-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 20;
}

.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 30;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.sheet-info {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.sheet-status {
  display: inline-block;
  margin: 8rpx 0 16rpx;
  padding: 4rpx 16rpx;
  font-size: 24rpx;
  color: #ff6b35;
  background: #fff3ee;
  border-radius: 8rpx;
}

.sheet-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet-btn {
  margin-top: 24rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.sheet-btn.half {
  flex: 1;
  margin-top: 0;
}

.sheet-close {
  margin-top: 16rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
}
