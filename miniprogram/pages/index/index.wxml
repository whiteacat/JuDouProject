<view class="page">
  <map
    id="map"
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
    bindmaptap="onMapTap"
  />

  <!-- 顶部标题栏 -->
  <view class="top-header">
    <view class="app-title">吃饭 · 玩乐 · 组队</view>
    <view class="app-subtitle">和有趣的人，一起发现好地方</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-wrap">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
      <input
        class="search-input"
        placeholder="搜索餐厅、地点、活动…"
        placeholder-style="color: #bbb"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
    </view>
    <button class="search-btn" bindtap="onSearch" disabled="{{searching}}">搜索</button>
  </view>

  <!-- 搜索结果列表（活动 + 餐厅混合）：头部固定，列表可滚动，支持点地图/收起/清空关键字关闭 -->
  <view wx:if="{{showResults && results.length > 0}}" class="results-panel">
    <view class="results-header">
      <text class="results-count">共 {{results.length}} 条结果</text>
      <view class="results-close" bindtap="hideResults">收起 ✕</view>
    </view>
    <scroll-view class="results-list" scroll-y>
      <view
        class="result-item"
        wx:for="{{results}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="onResultTap"
      >
        <view class="result-top">
          <view class="result-name">
            <text class="result-type {{item.type}}">{{item.type === 'event' ? '活动' : '餐厅'}}</text>
            {{item.name}}
          </view>
          <view class="result-dist" wx:if="{{item.distance_text}}">{{item.distance_text}}</view>
        </view>
        <view class="result-meta" wx:if="{{item.sub}}">{{item.sub}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部快捷入口卡片：可横向收起为悬浮球，悬浮球可拖动 -->
  <view class="quick-bar" wx:if="{{!quickCollapsed}}">
    <view class="quick-items">
      <view class="quick-item" bindtap="goCategory" data-category="聚餐">
        <view class="quick-icon quick-icon-eat">
          <image class="quick-icon-img" src="/assets/icons/restaurant.svg" mode="aspectFit" />
        </view>
        <text class="quick-label">聚餐</text>
      </view>
      <view class="quick-item" bindtap="goCategory" data-category="游玩">
        <view class="quick-icon quick-icon-play">
          <image class="quick-icon-img" src="/assets/icons/travel.svg" mode="aspectFit" />
        </view>
        <text class="quick-label">游玩</text>
      </view>
      <view class="quick-item" bindtap="goCategory" data-category="约会">
        <view class="quick-icon quick-icon-date">
          <image class="quick-icon-img" src="/assets/icons/heart.svg" mode="aspectFit" />
        </view>
        <text class="quick-label">约会</text>
      </view>
      <view class="quick-item" bindtap="goCreateEvent">
        <view class="quick-icon quick-icon-team">
          <image class="quick-icon-img" src="/assets/icons/users.svg" mode="aspectFit" />
        </view>
        <text class="quick-label">组队</text>
      </view>
    </view>
    <view class="quick-collapse-btn" bindtap="toggleQuickBar">
      <text class="quick-collapse-arrow">❯</text>
      <text class="quick-collapse-text">收起</text>
    </view>
  </view>

  <!-- 收起后的可拖动悬浮球：点击展开，拖动换位置，自动吸附左右边缘 -->
  <view
    wx:if="{{quickCollapsed}}"
    class="quick-ball"
    style="left: {{ballX}}px; top: {{ballY}}px;"
    bindtouchstart="onBallTouchStart"
    catchtouchmove="onBallTouchMove"
    bindtouchend="onBallTouchEnd"
  >
    <image class="quick-ball-icon" src="/assets/icons/menu.svg" mode="aspectFit" />
    <text class="quick-ball-text">快捷</text>
  </view>

  <!-- 餐厅详情弹层 -->
  <view wx:if="{{selectedRestaurant}}" class="sheet-mask" bindtap="closeSheets"></view>
  <view wx:if="{{selectedRestaurant}}" class="bottom-sheet">
    <view class="sheet-title">{{selectedRestaurant.name}}</view>
    <view class="sheet-info" wx:if="{{selectedRestaurant.category}}">分类：{{selectedRestaurant.category}}</view>
    <view class="sheet-info" wx:if="{{selectedRestaurant.address}}">地址：{{selectedRestaurant.address}}</view>
    <view class="sheet-info" wx:if="{{selectedRestaurant.phone}}">电话：{{selectedRestaurant.phone}}</view>
    <view class="sheet-row">
      <button class="sheet-btn half" bindtap="goRestaurantDetail">查看详情</button>
      <button class="sheet-btn half primary" bindtap="goCreateEventForRestaurant">发起组队</button>
    </view>
    <button class="sheet-close" bindtap="closeSheets">关闭</button>
  </view>

  <!-- 组队详情弹层 -->
  <view wx:if="{{selectedEvent}}" class="sheet-mask" bindtap="closeSheets"></view>
  <view wx:if="{{selectedEvent}}" class="bottom-sheet">
    <view class="sheet-title">{{selectedEvent.title}}</view>
    <view class="sheet-info">
      <image class="sheet-meta-icon" src="/assets/icons/clock.svg" mode="aspectFit" />{{selectedEvent.event_time_display}} · {{selectedEvent.current_members}}/{{selectedEvent.max_members}} 人
    </view>
    <view class="sheet-info" wx:if="{{selectedEvent.restaurant}}">餐厅：{{selectedEvent.restaurant.name}}</view>
    <view class="sheet-status">{{eventStatusText}}</view>
    <view class="sheet-row">
      <button class="sheet-btn half" bindtap="goEventDetail">查看详情</button>
      <button
        class="sheet-btn half primary"
        bindtap="joinEventFromMap"
        wx:if="{{selectedEvent.status === 'RECRUITING' || selectedEvent.status === 'CONFIRMED'}}"
      >加入组队</button>
    </view>
    <button class="sheet-close" bindtap="closeSheets">关闭</button>
  </view>
</view>
