.about-page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* Logo 区 */
.about-hero {
  padding: 80rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.about-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ff6b35, #ff9a5c);
  color: #fff;
  font-size: 72rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.about-name {
  margin-top: 24rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
}

.about-version {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #bbb;
}

/* 简介卡 */
.about-card {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.about-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-line;
}

.about-features {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  font-size: 26rpx;
  color: #666;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}

/* 协议菜单 */
.about-menu {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.about-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.about-menu-item:last-child {
  border-bottom: none;
}

.about-menu-label {
  font-size: 28rpx;
  color: #333;
}

.about-menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.about-footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
}
