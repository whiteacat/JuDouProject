.doc-page {
  min-height: 100vh;
  background: #fff;
  padding: 40rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
}

.doc-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #222;
  text-align: center;
}

.doc-updated {
  margin-top: 12rpx;
  margin-bottom: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
}

.doc-h {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-top: 40rpx;
  margin-bottom: 16rpx;
}

.doc-p {
  font-size: 27rpx;
  color: #666;
  line-height: 1.8;
}
