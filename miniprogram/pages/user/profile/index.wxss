.container {
  min-height: 100vh;
  background: #f7f7f7;
}

/* 用户信息卡 */
.profile-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6b35, #ff9a5c);
  padding: 48rpx 32rpx;
  color: #fff;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.4);
}

.avatar-fallback {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.avatar-edit-img {
  width: 22rpx;
  height: 22rpx;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
}

.signature {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.85;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-entry {
  font-size: 26rpx;
  opacity: 0.85;
  flex-shrink: 0;
  padding-left: 16rpx;
}

/* 数据统计 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 28rpx 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b35;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 功能菜单 */
.menu {
  background: #fff;
  margin-bottom: 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #fff3ee;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-icon {
  width: 28rpx;
  height: 28rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 退出登录 */
.logout {
  margin: 48rpx 32rpx;
  background: #fff;
  color: #e64340;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.logout::after {
  border: none;
}

/* 未登录态 */
.unlogged {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff9a5c);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: bold;
}

.unlogged-title {
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.unlogged-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #999;
}

.login-btn {
  margin-top: 48rpx;
  width: 400rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 16rpx;
}

.login-btn::after {
  border: none;
}
