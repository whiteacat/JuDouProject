.container {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

/* 用户信息卡 */
.header-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6b35, #ff9a5c);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: bold;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-info {
  margin-left: 28rpx;
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
}

.uid {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

/* 功能菜单 */
.menu {
  background: #fff;
  border-radius: 24rpx;
  margin-top: 24rpx;
  padding: 0 32rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-text {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 退出登录 */
.logout {
  margin-top: 48rpx;
  background: #fff;
  color: #e64340;
  border-radius: 16rpx;
  font-size: 30rpx;
}

/* 未登录态 */
.unlogged {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b35, #ff9a5c);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: bold;
}

.unlogged-text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #999;
}

.login-btn {
  margin-top: 48rpx;
  width: 400rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 16rpx;
}
