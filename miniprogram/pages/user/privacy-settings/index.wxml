<view class="container">
  <!-- 协议入口 -->
  <view class="menu-group">
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="menu-item"
      data-key="{{item.key}}"
      bindtap="onTapItem"
    >
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-label">清除本地缓存</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-group">
    <view class="menu-item danger" bindtap="onLogout">
      <text class="menu-label danger-text">退出登录</text>
    </view>
  </view>

  <view class="footer-tip">清除缓存仅影响本地数据，你的群组、活动与收藏不受影响</view>
</view>
