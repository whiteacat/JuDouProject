.container {
  min-height: 100vh;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

/* 分区 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #999;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

/* 当前头像 */
.current-avatar {
  display: flex;
  justify-content: center;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

/* 微信头像按钮 */
.wechat-avatar-btn {
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.wechat-avatar-btn::after {
  border: none;
}

/* 预设头像网格 */
.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.preset-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.preset-item.active {
  border-color: #ff6b35;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 53, 0.2);
}

.preset-img {
  width: 100%;
  height: 100%;
}

/* 昵称输入 */
.nickname-input {
  border-bottom: 2rpx solid #e5e5e5;
  padding-bottom: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.nickname-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* 保存按钮 */
.save-btn {
  margin-top: 48rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.save-btn[disabled] {
  background-color: #ccc;
  color: #999;
}
