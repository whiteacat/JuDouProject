.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

/* 分区 */
.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #999;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

.char-hint {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 头像 */
.current-avatar {
  display: flex;
  justify-content: center;
  position: relative;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.camera-badge {
  position: absolute;
  bottom: 0;
  left: 50%;
  margin-left: 40rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.camera-badge-img {
  width: 26rpx;
  height: 26rpx;
}

.wechat-avatar-btn {
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 16rpx;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.wechat-avatar-btn::after {
  border: none;
}

/* 预设头像网格 */
.preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.preset-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.preset-item.active {
  border-color: #ff6b35;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 53, 0.2);
}

.preset-img {
  width: 100%;
  height: 100%;
}

/* 昵称输入 */
.nickname-input {
  border-bottom: 2rpx solid #e5e5e5;
  padding-bottom: 16rpx;
  font-size: 30rpx;
  color: #333;
}

/* 个性签名 */
.signature-input {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  min-height: 100rpx;
  line-height: 1.6;
  border-bottom: 2rpx solid #e5e5e5;
  padding-bottom: 16rpx;
}

/* 偏好标签 */
.pref-group {
  margin-bottom: 28rpx;
}

.pref-group:last-child {
  margin-bottom: 0;
}

.pref-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.pref-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pref-tag {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
}

.pref-tag.active {
  color: #ff6b35;
  background: #fff3ee;
  border-color: #ff6b35;
}

/* 其他设置 */
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-value {
  font-size: 26rpx;
  color: #999;
}

/* 保存按钮 */
.save-btn {
  margin-top: 48rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  background-color: #ccc;
  color: #999;
  box-shadow: none;
}
