<view class="container">
  <view wx:if="{{groups.length === 0 && !loading}}" class="empty">
    还没有加入任何群组，去群组页创建一个吧
  </view>

  <view class="list">
    <view
      wx:for="{{groups}}"
      wx:key="id"
      class="item"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image wx:if="{{item.avatar_src}}" class="item-avatar" src="{{item.avatar_src}}" mode="aspectFill" />
      <view wx:else class="item-avatar-text">{{item.name[0]}}</view>
      <view class="item-info">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">{{item.member_count}} 位成员</view>
      </view>
    </view>
  </view>
</view>
