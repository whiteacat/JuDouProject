<view class="container">
  <!-- 顶部操作栏 -->
  <view class="top-bar">
    <view class="search-wrap">
      <image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
      <input class="search-input" placeholder="搜索群组名称" placeholder-style="color: #bbb" value="{{keyword}}" bindinput="onSearch" />
    </view>
    <view class="add-btn" bindtap="goCreate">
      <image class="add-btn-img" src="/assets/icons/plus.svg" mode="aspectFit" />
    </view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{groups.length === 0 && !loading}}" class="empty">
    还没有加入任何群组，创建一个或输入邀请码加入
  </view>

  <!-- 群组列表 -->
  <view class="group-list">
    <view
      wx:for="{{filteredGroups}}"
      wx:key="id"
      class="group-card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image wx:if="{{item.avatar_src}}" class="group-avatar" src="{{item.avatar_src}}" mode="aspectFill" />
      <view wx:else class="group-avatar-text">{{item.name[0]}}</view>
      <view class="group-info">
        <view class="group-name">{{item.name}}</view>
        <view class="group-meta">{{item.member_count}} 位成员</view>
      </view>
      <view class="manage-btn" catchtap="goDetail" data-id="{{item.id}}">管理 ›</view>
    </view>
  </view>

  <!-- 底部入口 -->
  <view class="footer">
    <button class="btn primary" bindtap="goCreate">创建群组</button>
    <button class="btn secondary" bindtap="goJoin">输入邀请码加入</button>
  </view>
</view>
