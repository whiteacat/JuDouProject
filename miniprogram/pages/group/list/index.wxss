.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.group-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.group-name {
  font-size: 34rpx;
  font-weight: bold;
}

.group-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx;
  background: #fff;
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn.primary {
  background-color: #ff6b35;
  color: #fff;
}

.btn.secondary {
  background-color: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
}
