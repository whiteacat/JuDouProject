.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.header {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.name {
  font-size: 40rpx;
  font-weight: bold;
}

.meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.invite-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-code {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 6rpx;
  color: #ff6b35;
}

.copy-btn {
  margin: 0;
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 56rpx;
  background-color: #fff3ee;
  color: #ff6b35;
  border-radius: 8rpx;
}

.member-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: #ff6b35;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.member-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #ff6b35;
}

.entry {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.entry:last-child {
  border-bottom: none;
}

.entry-text {
  margin-left: 16rpx;
}
