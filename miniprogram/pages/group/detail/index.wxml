<view class="container" wx:if="{{group}}">
  <!-- 邀请落地引导：登录/带邀请码后一键入群 -->
  <view class="invite-banner" wx:if="{{inviteMode}}">
    <view class="invite-banner-text">
      {{inviteJoinReady ? '登录后即可加入该群组' : '加入后即可浏览群组活动并参与组队'}}
    </view>
    <button class="invite-banner-btn" bindtap="onInviteEnter" disabled="{{inviteJoining}}">
      {{inviteJoining ? '处理中…' : (inviteJoinReady ? '去登录' : '一键加入')}}
    </button>
  </view>

  <!-- 顶部封面 -->
  <view class="cover-section" bindtap="openCoverPicker">
    <image class="cover-bg" src="{{group.cover_src || group.avatar_src || '/assets/icons/default-cover.png'}}" mode="aspectFill" />
    <view class="cover-overlay"></view>
    <view class="cover-info">
      <view class="group-name">{{group.name}}</view>
      <view class="group-meta">{{group.member_count}} 位成员 · 活跃 {{group.active_count}} 人</view>
      <view class="owner-row" wx:if="{{owner}}">
        <image wx:if="{{owner.avatar_src}}" class="owner-avatar-img" src="{{owner.avatar_src}}" mode="aspectFill" />
        <view wx:else class="owner-avatar">{{owner.short}}</view>
        <text class="owner-label">{{owner.nickname}}</text>
        <text class="owner-tag">群主</text>
      </view>
      <view class="joined-badge" wx:if="{{isMember}}">已加入</view>
    </view>
    <view class="cover-edit-badge" wx:if="{{isOwner}}">更换封面</view>
  </view>

  <!-- 功能按钮行 -->
  <view class="action-row">
    <view class="action-item" bindtap="goCreateEvent">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/plus.svg" mode="aspectFit" />
      </view>
      <text class="action-label">发起活动</text>
    </view>
    <view class="action-item" bindtap="toggleMembers">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/users.svg" mode="aspectFit" />
      </view>
      <text class="action-label">成员列表</text>
    </view>
    <view class="action-item" bindtap="onAnnouncement">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/announcement.svg" mode="aspectFit" />
      </view>
      <text class="action-label">群公告</text>
    </view>
    <button class="action-item action-item-btn" open-type="share">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/heart.svg" mode="aspectFit" />
      </view>
      <text class="action-label">邀请好友</text>
    </button>
    <view class="action-item" bindtap="onMore">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/more.svg" mode="aspectFit" />
      </view>
      <text class="action-label">更多</text>
    </view>
  </view>

  <!-- 邀请码 -->
  <view class="section-card">
    <view class="section-title">邀请码</view>
    <view class="invite-row">
      <text class="invite-code">{{group.invite_code}}</text>
      <button class="copy-btn" bindtap="onCopyCode">复制</button>
    </view>
  </view>

  <!-- 群公告 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-title">群公告</view>
      <view class="section-link" wx:if="{{isOwner}}">编辑 ›</view>
    </view>
    <view wx:if="{{announcement}}" class="announcement-box">
      <view class="announcement-content">{{announcement.content}}</view>
      <view class="announcement-time" wx:if="{{announcement.time_display}}">更新于 {{announcement.time_display}}</view>
    </view>
    <view wx:else class="empty-hint">暂无公告{{isOwner ? '，点击「编辑」发布第一条' : ''}}</view>
  </view>

  <!-- 群组活动 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-title">群组组队</view>
      <view class="section-link" bindtap="goGroupEvents">查看全部 ›</view>
    </view>
    <view wx:if="{{recentEvents.length === 0}}" class="empty-hint">暂无组队，点击上方「发起活动」创建</view>
    <view wx:for="{{recentEvents}}" wx:key="id" class="event-mini" data-id="{{item.id}}" bindtap="goEventDetail">
      <view class="event-mini-top">
        <view class="event-mini-title">{{item.title}}</view>
        <view class="event-mini-status">{{item.status_text}}</view>
      </view>
      <view class="event-mini-meta">
        <image class="mini-meta-icon" src="/assets/icons/clock.svg" mode="aspectFit" />{{item.time_display}} · {{item.current_members}}/{{item.max_members}} 人
      </view>
    </view>
  </view>

  <!-- 群成员 -->
  <view class="section-card">
    <view class="section-header">
      <view class="section-title">群成员（{{members.length}}）</view>
      <view class="section-link" wx:if="{{members.length > 8}}">查看更多 ›</view>
    </view>
    <view class="member-grid">
      <view wx:for="{{showMembers}}" wx:key="user_id" class="member">
        <image wx:if="{{item.avatar_src}}" class="member-avatar-img" src="{{item.avatar_src}}" mode="aspectFill" />
        <view wx:else class="member-avatar">{{item.short}}</view>
        <view class="member-name">{{item.nickname}}</view>
        <view wx:if="{{item.role === 'OWNER'}}" class="member-role">群主</view>
      </view>
    </view>
  </view>
</view>

<!-- 公告编辑弹窗（仅群主） -->
<view class="ann-mask" wx:if="{{showAnnouncementEditor}}" bindtap="closeAnnouncementEditor"></view>
<view class="ann-sheet" wx:if="{{showAnnouncementEditor}}">
  <view class="ann-title">发布群公告</view>
  <textarea
    class="ann-textarea"
    placeholder="填写公告内容，如：本周五火锅局集合地点…"
    value="{{announcementDraft}}"
    bindinput="onAnnouncementInput"
    maxlength="500"
    auto-height
  />
  <view class="ann-count">{{announcementDraft.length}}/500</view>
  <view class="ann-actions">
    <button
      class="ann-btn danger"
      wx:if="{{announcement}}"
      catchtap="onDeleteAnnouncement"
      disabled="{{announcementSaving}}"
    >删除公告</button>
    <button class="ann-btn" catchtap="closeAnnouncementEditor">取消</button>
    <button class="ann-btn primary" catchtap="saveAnnouncement" disabled="{{announcementSaving}}">
      {{announcementSaving ? '保存中' : '保存'}}
    </button>
  </view>
</view>

<!-- 封面背景选择弹窗（仅群主） -->
<view class="cover-mask" wx:if="{{showCoverPicker}}" bindtap="closeCoverPicker"></view>
<view class="cover-sheet" wx:if="{{showCoverPicker}}">
  <view class="cover-sheet-title">选择群组封面</view>
  <view class="cover-grid">
    <view
      wx:for="{{groupCovers}}"
      wx:key="key"
      class="cover-cell {{group.cover_url === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      catchtap="onPickCover"
    >
      <image class="cover-cell-img" src="{{item.image}}" mode="aspectFill" />
      <view class="cover-cell-check" wx:if="{{group.cover_url === item.key}}">✓</view>
    </view>
  </view>
  <view class="cover-sheet-actions">
    <button class="cover-clear-btn" catchtap="onClearCover" disabled="{{coverSaving}}" wx:if="{{group.cover_url}}">
      恢复默认背景
    </button>
    <button class="cover-cancel-btn" catchtap="closeCoverPicker">关闭</button>
  </view>
</view>
