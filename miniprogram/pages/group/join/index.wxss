.container {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: #fff;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.input {
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 48rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.submit {
  background-color: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
}
