<wxs src="./strlen.wxs" module="s" />
<view class="container">
  <!-- 活动类型选择 -->
  <view class="type-section">
    <view class="section-label">活动类型</view>
    <view class="type-grid">
      <view class="type-item {{category === '聚餐' ? 'active' : ''}}" data-cat="聚餐" bindtap="onCategoryChange">
        <view class="type-icon">
          <image class="type-icon-img" src="/assets/icons/restaurant.svg" mode="aspectFit" />
        </view>
        <text class="type-text">聚餐</text>
      </view>
      <view class="type-item {{category === '游玩' ? 'active' : ''}}" data-cat="游玩" bindtap="onCategoryChange">
        <view class="type-icon">
          <image class="type-icon-img" src="/assets/icons/travel.svg" mode="aspectFit" />
        </view>
        <text class="type-text">游玩</text>
      </view>
      <view class="type-item {{category === '约会' ? 'active' : ''}}" data-cat="约会" bindtap="onCategoryChange">
        <view class="type-icon">
          <image class="type-icon-img" src="/assets/icons/heart.svg" mode="aspectFit" />
        </view>
        <text class="type-text">约会</text>
      </view>
      <view class="type-item {{category === '其他' ? 'active' : ''}}" data-cat="其他" bindtap="onCategoryChange">
        <view class="type-icon">
          <image class="type-icon-img" src="/assets/icons/tag.svg" mode="aspectFit" />
        </view>
        <text class="type-text">其他</text>
      </view>
    </view>
  </view>

  <!-- 封面图选择（按主题默认，可更换，不可上传） -->
  <view class="form-card">
    <view class="label">封面图</view>
    <view class="cover-preview">
      <image class="cover-preview-img" src="{{coverSrc}}" mode="aspectFill" />
      <view class="cover-preview-tag">仅支持预设封面</view>
    </view>
    <scroll-view class="cover-list" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{presetCovers}}"
        wx:key="key"
        class="cover-item {{coverUrl === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onCoverSelect"
      >
        <image class="cover-item-img" src="{{item.image}}" mode="aspectFill" />
        <view wx:if="{{coverUrl === item.key}}" class="cover-item-check">✓</view>
      </view>
    </scroll-view>
  </view>

  <!-- 基本信息 -->
  <view class="form-card">
    <view class="field">
      <view class="label">标题</view>
      <input class="input" placeholder="如：周五火锅局" value="{{title}}" bindinput="onTitleInput" maxlength="64" />
    </view>

    <view class="field">
      <view class="label">选择地点</view>
      <view class="picker-value {{restaurantName ? '' : 'placeholder'}}" bindtap="onPickLocation">
        {{restaurantName || '请选择餐厅或地点'}}
        <text class="picker-arrow">❯</text>
      </view>
      <!-- 地点选择方式面板 -->
      <view class="loc-sheet-mask" wx:if="{{showLocPanel}}" bindtap="onCancelLocPanel"></view>
      <view class="loc-sheet" wx:if="{{showLocPanel}}">
        <view class="loc-sheet-title">选择组队地点</view>
        <view class="loc-search-row">
          <input
            class="loc-search-input"
            placeholder="搜索餐厅名称"
            placeholder-style="color: #bbb"
            value="{{locKeyword}}"
            bindinput="onLocKeywordInput"
            bindconfirm="onSearchRestaurant"
            confirm-type="search"
          />
          <button class="loc-search-btn" size="mini" bindtap="onSearchRestaurant" disabled="{{locSearching}}">
            {{locSearching ? '搜索中' : '搜索'}}
          </button>
        </view>
        <scroll-view class="loc-results" scroll-y wx:if="{{locResults.length > 0}}">
          <view
            class="loc-result-item"
            wx:for="{{locResults}}"
            wx:key="id"
            hover-class="loc-result-hover"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-lat="{{item.latitude}}"
            data-lng="{{item.longitude}}"
            bindtap="onSelectRestaurant"
          >
            <view class="loc-result-name">{{item.name}}</view>
            <view class="loc-result-addr" wx:if="{{item.address}}">{{item.address}}</view>
          </view>
        </scroll-view>
        <view class="loc-empty" wx:elif="{{locSearched}}">未找到相关餐厅</view>
        <button class="loc-map-btn" bindtap="onChooseOnMap">📍 在地图上选点</button>
        <button class="loc-cancel" bindtap="onCancelLocPanel">取消</button>
      </view>
    </view>

    <view class="field">
      <view class="label">活动时间</view>
      <view class="picker-row">
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="picker-value">{{date || '请选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{time}}" bindchange="onTimeChange">
          <view class="picker-value">{{time || '请选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="label">人均预算</view>
      <view class="budget-row">
        <input
          class="input budget-input"
          type="digit"
          placeholder="选填，如 88"
          placeholder-style="color: #bbb"
          value="{{budget}}"
          bindinput="onBudgetInput"
          maxlength="8"
        />
        <text class="budget-unit">元/人</text>
      </view>
    </view>

    <view class="field">
      <view class="label">参与人数</view>
      <view class="member-row">
        <text class="member-label">最少</text>
        <input class="num-input" type="number" value="{{minMembers}}" bindinput="onMinInput" />
        <text class="member-label">最多</text>
        <input class="num-input" type="number" value="{{maxMembers}}" bindinput="onMaxInput" />
      </view>
    </view>

    <view class="field">
      <view class="label">活动描述（可选）</view>
      <textarea
        class="textarea"
        placeholder="介绍一下活动，吸引更多人加入…"
        value="{{remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
        auto-height
      />
      <view class="char-count">{{s.len(remark)}}/200</view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="form-card">
    <view class="label">添加标签（可选）</view>
    <view class="tag-list">
      <view wx:for="{{selectedTags}}" wx:key="*this" class="tag-item">
        {{item}}
        <text class="tag-remove" data-tag="{{item}}" catchtap="onRemoveTag">×</text>
      </view>
      <view class="tag-add" bindtap="onAddTag">+</view>
    </view>
  </view>

  <!-- 失效策略 -->
  <view class="form-card">
    <view class="label">失效策略</view>
    <view class="expiry-list">
      <view
        wx:for="{{expiryModes}}"
        wx:key="key"
        class="expiry-option {{expiryMode === item.key ? 'active' : ''}}"
        data-mode="{{item.key}}"
        bindtap="onExpiryModeChange"
      >
        <view class="expiry-radio {{expiryMode === item.key ? 'on' : ''}}"></view>
        <view>
          <view class="expiry-label">{{item.label}}</view>
          <view class="expiry-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>

    <block wx:if="{{expiryMode === 'at_time'}}">
      <view class="sub-field">
        <view class="label">失效时间</view>
        <view class="picker-row">
          <picker mode="date" value="{{expiryDate}}" bindchange="onExpiryDateChange">
            <view class="picker-value">{{expiryDate || '请选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{expiryTime}}" bindchange="onExpiryTimeChange">
            <view class="picker-value">{{expiryTime || '请选择时间'}}</view>
          </picker>
        </view>
      </view>
    </block>

    <block wx:if="{{expiryMode === 'after_hours'}}">
      <view class="sub-field">
        <view class="label">创建后多少小时失效</view>
        <input class="num-input" type="number" value="{{expiresAfterHours}}" bindinput="onExpiryHoursInput" />
      </view>
    </block>
  </view>

  <!-- 我的可参加时段 -->
  <view class="form-card">
    <view class="field-head">
      <view class="label">我的可参加时段</view>
      <switch checked="{{windowEnabled}}" bindchange="onWindowToggle" color="#ff6b35" />
    </view>
    <view wx:if="{{windowEnabled}}" class="sub-field">
      <view class="window-hint">告诉群里的人你能来的时间，可跨多天、每天多段</view>
      <view wx:for="{{myWindows}}" wx:key="index" wx:for-item="w" wx:for-index="i" class="window-item">
        <view class="picker-row">
          <picker mode="date" value="{{w.date}}" data-index="{{i}}" bindchange="onWindowDateChange">
            <view class="picker-value">{{w.date || '日期'}}</view>
          </picker>
          <picker mode="time" value="{{w.start}}" data-index="{{i}}" bindchange="onWindowStartChange">
            <view class="picker-value">{{w.start || '开始'}}</view>
          </picker>
          <text class="window-sep">~</text>
          <picker mode="time" value="{{w.end}}" data-index="{{i}}" bindchange="onWindowEndChange">
            <view class="picker-value">{{w.end || '结束'}}</view>
          </picker>
        </view>
        <view class="window-del" data-index="{{i}}" catchtap="onRemoveWindow">删除该时段</view>
      </view>
      <view class="window-add" bindtap="onAddWindow">+ 添加时段</view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit" bindtap="onSubmit" disabled="{{submitting}}">发布活动</button>
</view>
