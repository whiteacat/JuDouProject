.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.group-name,
.restaurant-name {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.input {
  font-size: 30rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.num-input {
  width: 96rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  text-align: center;
  font-size: 30rpx;
}

.submit {
  margin-top: 48rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
}
