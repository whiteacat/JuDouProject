.container {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.group-name,
.restaurant-name {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.input {
  font-size: 30rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.num-input {
  width: 96rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  text-align: center;
  font-size: 30rpx;
}

.expiry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.expiry-option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.expiry-option.active {
  border-color: #ff6b35;
  background: #fff8f5;
}

.expiry-radio {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-top: 4rpx;
  box-sizing: border-box;
}

.expiry-radio.on {
  border: 12rpx solid #ff6b35;
}

.expiry-label {
  font-size: 30rpx;
  color: #333;
}

.expiry-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.sub-field {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2f2f2;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-head .label {
  margin-bottom: 0;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-row picker {
  flex: 1;
}

.window-sep {
  color: #999;
  font-size: 28rpx;
}

.window-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.window-item {
  margin-top: 20rpx;
}

.window-item .picker-row {
  margin-top: 0;
}

.window-del {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: #e64340;
}

.window-add {
  margin-top: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #ff6b35;
  border: 2rpx dashed #ffb994;
  border-radius: 12rpx;
}

.submit {
  margin-top: 48rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 12rpx;
}
