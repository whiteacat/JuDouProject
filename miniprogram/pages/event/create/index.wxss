.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

/* 活动类型选择 */
.type-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.type-grid {
  display: flex;
  justify-content: space-around;
}

.type-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.type-item.active {
  border-color: #ff6b35;
  background: #fff8f5;
}

.type-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff3ee;
  display: flex;
  align-items: center;
  justify-content: center;
}

.type-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.type-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 封面图选择 */
.cover-preview {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cover-preview-img {
  width: 100%;
  height: 100%;
}

.cover-preview-tag {
  position: absolute;
  right: 0;
  bottom: 0;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-top-left-radius: 12rpx;
}

.cover-list {
  width: 100%;
  white-space: nowrap;
}

.cover-item {
  position: relative;
  display: inline-block;
  width: 220rpx;
  margin-right: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  vertical-align: top;
  transition: all 0.2s;
}

.cover-item:last-child {
  margin-right: 0;
}

.cover-item.active {
  border-color: #ff6b35;
}

.cover-item-img {
  width: 220rpx;
  height: 90rpx;
  display: block;
}

.cover-item-check {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ff6b35;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.input {
  font-size: 30rpx;
  color: #333;
}

.textarea {
  width: 100%;
  font-size: 28rpx;
  color: #333;
  min-height: 120rpx;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #ccc;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-row picker {
  flex: 1;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.member-label {
  color: #666;
}

.num-input {
  width: 96rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: #fff3ee;
  color: #ff6b35;
  font-size: 24rpx;
  border-radius: 20rpx;
}

.tag-remove {
  font-size: 28rpx;
  color: #ff6b35;
  margin-left: 4rpx;
}

.tag-add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx dashed #ffb994;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ff6b35;
}

/* 失效策略 */
.expiry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.expiry-option {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.expiry-option.active {
  border-color: #ff6b35;
  background: #fff8f5;
}

.expiry-radio {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-top: 4rpx;
  box-sizing: border-box;
}

.expiry-radio.on {
  border: 12rpx solid #ff6b35;
}

.expiry-label {
  font-size: 30rpx;
  color: #333;
}

.expiry-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.sub-field {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2f2f2;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-head .label {
  margin-bottom: 0;
}

.window-sep {
  color: #999;
  font-size: 28rpx;
}

.window-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.window-item {
  margin-top: 20rpx;
}

.window-item .picker-row {
  margin-top: 0;
}

.window-del {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: #e64340;
}

.window-add {
  margin-top: 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #ff6b35;
  border: 2rpx dashed #ffb994;
  border-radius: 12rpx;
}

/* 提交按钮 */
.submit {
  margin-top: 48rpx;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.submit::after {
  border: none;
}
