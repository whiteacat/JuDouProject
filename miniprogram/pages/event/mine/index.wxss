.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 0;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.35;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #666;
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #aaa;
  text-align: center;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 0 64rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
}

.empty-btn::after {
  border: none;
}

/* 活动卡片（与收藏页同款） */
.fav-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.fav-card-hover {
  background: #fafafa;
}

.fav-cover {
  width: 220rpx;
  height: 160rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.fav-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.fav-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fav-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-status {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #ff6b35;
  background: #fff3ee;
  border-radius: 8rpx;
}

.fav-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fav-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fav-budget {
  font-size: 26rpx;
  font-weight: bold;
  color: #ff6b35;
}
