.container {
  min-height: 100vh;
  background: #f7f7f7;
}

/* 位置信息栏 */
.location-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff;
}

.location-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
}

.location-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 分类标签栏 */
.tab-bar {
  display: flex;
  white-space: nowrap;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 32rpx;
  background: #f5f5f5;
  transition: all 0.2s;
}

.tab-item.active {
  background: #ff6b35;
  color: #fff;
  font-weight: bold;
}

/* 空态 */
.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 活动卡片列表 */
.event-list {
  padding: 24rpx;
}

.event-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 封面图 */
.card-cover {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.card-tag {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 107, 53, 0.9);
  border-radius: 20rpx;
}

/* 卡片内容 */
.card-body {
  padding: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-status {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff3ee;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.card-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

/* 底部栏 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.card-avatars {
  display: flex;
  align-items: center;
}

.mini-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.avatar-count {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.join-btn {
  margin: 0;
  padding: 0 40rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 30rpx;
}

.join-btn::after {
  border: none;
}
