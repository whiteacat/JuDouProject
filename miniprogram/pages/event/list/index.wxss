.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.empty {
  margin-top: 200rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.event-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.event-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.event-title {
  font-size: 34rpx;
  font-weight: bold;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-status {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff3ee;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.event-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.event-restaurant {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}
