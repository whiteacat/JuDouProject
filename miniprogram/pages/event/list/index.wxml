<view class="container">
  <!-- 群名信息 -->
  <view class="group-bar" wx:if="{{groupName}}">
    <text class="group-label">{{groupName}}</text>
    <text class="group-count">{{events.length}} 个活动</text>
  </view>

  <!-- 分类标签栏 -->
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab-item {{tabIndex === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >{{item}}</view>
  </scroll-view>

  <!-- 空态 -->
  <view wx:if="{{events.length === 0 && !loading}}" class="empty">
    暂无{{tabIndex > 0 ? tabs[tabIndex] : ''}}活动，去发起一个吧
  </view>

  <!-- 活动卡片列表 -->
  <view class="event-list">
    <view
      wx:for="{{events}}"
      wx:key="id"
      class="event-card"
      hover-class="event-card-hover"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="card-body">
        <!-- 标题行 -->
        <view class="card-header">
          <view class="card-tag" wx:if="{{item.category}}">{{item.category}}</view>
          <view class="card-title">{{item.title}}</view>
          <view class="card-status">{{item.status_text}}</view>
        </view>

        <!-- 地点 + 时间 -->
        <view class="card-meta" wx:if="{{item.restaurant}}">
          <image class="meta-icon" src="/assets/icons/restaurant.svg" mode="aspectFit" />{{item.restaurant.name}}
        </view>
        <view class="card-meta">
          <image class="meta-icon" src="/assets/icons/clock.svg" mode="aspectFit" />{{item.time_display}} · {{item.current_members}}/{{item.max_members}} 人
        </view>

        <!-- 底部：人数 + 加入按钮 -->
        <view class="card-footer">
          <view class="card-participants">
            <image class="meta-icon" src="/assets/icons/users.svg" mode="aspectFit" />
            已加入 {{item.current_members}} 人
          </view>
          <button
            class="join-btn"
            wx:if="{{item.status === 'RECRUITING'}}"
            catchtap="joinEvent"
            data-id="{{item.id}}"
          >加入</button>
        </view>
      </view>
    </view>
  </view>
</view>
