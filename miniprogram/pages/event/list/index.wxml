<view class="container">
  <!-- 顶部位置信息 -->
  <view class="location-bar">
    <text class="location-label">当前位置</text>
    <text class="location-text">{{locationText || '定位中…'}}</text>
  </view>

  <!-- 分类标签栏 -->
  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="tab-item {{tabIndex === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabChange"
    >{{item}}</view>
  </scroll-view>

  <!-- 空态 -->
  <view wx:if="{{events.length === 0 && !loading}}" class="empty">
    暂无活动，去发起一个吧
  </view>

  <!-- 活动卡片列表 -->
  <view class="event-list">
    <view
      wx:for="{{events}}"
      wx:key="id"
      class="event-card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <!-- 封面图 -->
      <view class="card-cover" wx:if="{{item.cover_url}}">
        <image class="cover-img" src="{{item.cover_url}}" mode="aspectFill" />
        <view class="card-tag">{{item.category || '组队'}}</view>
      </view>

      <view class="card-body">
        <!-- 标题行 -->
        <view class="card-header">
          <view class="card-title">{{item.title}}</view>
          <view class="card-status">{{item.status_text}}</view>
        </view>

        <!-- 地点 + 时间 -->
        <view class="card-meta" wx:if="{{item.restaurant}}">
          🍽 {{item.restaurant.name}}{{item.distance ? ' · ' + item.distance : ''}}
        </view>
        <view class="card-meta">🕐 {{item.time_display}} · {{item.current_members}}/{{item.max_members}} 人</view>
        <view class="card-meta" wx:if="{{item.budget}}">💰 人均 {{item.budget}}</view>

        <!-- 底部：头像 + 加入按钮 -->
        <view class="card-footer">
          <view class="card-avatars">
            <image wx:if="{{item.creator_avatar_src}}" class="mini-avatar" src="{{item.creator_avatar_src}}" mode="aspectFill" />
            <view class="avatar-count" wx:if="{{item.current_members > 1}}">+{{item.current_members - 1}}</view>
          </view>
          <button
            class="join-btn"
            wx:if="{{item.status === 'RECRUITING'}}"
            catchtap="joinEvent"
            data-id="{{item.id}}"
          >加入</button>
        </view>
      </view>
    </view>
  </view>
</view>
