# 复制为 deploy/.env 并按需修改

# 数据库（本地直连 / docker 内由 compose 覆盖）
DATABASE_URL=postgresql+asyncpg://judou:judou@localhost:5432/judou

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥（生产环境务必更换）
JWT_SECRET=change-me-in-production

# 微信小程序（未配置时后端进入 mock 登录模式）
WECHAT_APPID=
WECHAT_SECRET=

# 高德地图 Web 服务 Key（未配置时 POI 搜索使用 mock 数据）
AMAP_KEY=

# 调试模式（开启后输出 SQL 日志）
DEBUG=false
